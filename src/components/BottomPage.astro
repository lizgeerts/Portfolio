          d="M10.7061 11.9697C10.7061 10.3581 11.6717 9.09977 12.792 8.22754C13.3477 7.79489 13.9243 7.47228 14.3965 7.26465C14.6326 7.16086 14.8366 7.08798 14.9932 7.04492C15.0925 7.01763 15.1552 7.00732 15.1875 7.00293H15.2725L15.334 6.00684C15.3139 6.00434 15.2933 6.0059 15.2725 6.00488V6.00293H15.2354C15.2125 6.0027 15.1894 6.00171 15.166 6.00293H0.25V7.00293H12.792C12.5881 7.13523 12.3814 7.27991 12.1777 7.43848C10.9344 8.40649 9.70605 9.92384 9.70605 11.9697H10.7061Z"
          stroke="#01070F"
          stroke-width="0.5"></path>
      </svg>
    </button>
  </section>

  <BackButton href="#start" color="black" />
  <Footer color="white" />
</div>
