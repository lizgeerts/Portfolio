---
import flower from "../assets/icons/flower.svg";

---

<div class="loader" aria-hidden="true">
  <img src={flower.src} alt="blue flower" class="loader__flower" />

  <p class="loader__name area">
    Loading
  </p>
</div>

<style>
  .loader {
    display: none; /* only on first visit : html.is-loading */
    position: fixed;
    inset: 0;
    z-index: 9999;
    height: 100dvh;
    background-color: var(--black);
    color: var(--white);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  html.is-loading .loader {
    display: flex;
  }

  html.is-loading {
    overflow: hidden;
  }

  .loader__flower {
    width: clamp(3.5rem, 8vw, 5.5rem);
    height: auto;
    visibility: hidden;
  }

  .loader__name {
    display: flex;
    font-size: var(--H3);
    font-weight: 600;
  }

  .loader__mask {
    display: inline-block;
    overflow: hidden;
    padding-block: 0.1em;
    margin-block: -0.1em;
  }

  .loader__char {
    display: inline-block;
    visibility: hidden;
  }
</style>


<script>
  import { gsap } from "gsap";

  const root = document.documentElement;
  const loader = document.querySelector<HTMLElement>(".loader");

  if (loader && root.classList.contains("is-loading")) {
    let finished = false;

    const finish = () => {
      if (finished) return;
      finished = true;
      clearTimeout(failsafe);
      root.classList.remove("is-loading");
      root.classList.add("is-loaded");
      loader.remove();
      document.dispatchEvent(new CustomEvent("loader:done"));
    };

    const failsafe = setTimeout(finish, 6000);

    const play = () => {
      const flowerEl = loader.querySelector(".loader__flower");
      const chars = loader.querySelectorAll(".loader__char");

      gsap.set(flowerEl, { scale: 0, rotation: -360, visibility: "visible" });
      gsap.set(chars, { yPercent: 110, visibility: "visible" });

      gsap
        .timeline({ onComplete: finish })
        .to(flowerEl, {
          scale: 1,
          rotation: 0,
          duration: 0.9,
          ease: "back.out(1.6)",
        })
        .to(
          chars,
          { yPercent: 0, duration: 0.6, stagger: 0.05, ease: "power4.out" },
          0.3,
        )
        .to(
          loader,
          { yPercent: 0, duration: 0.8, ease: "expo.inOut", opacity: 0 },
          0.3,
        );
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      finish(); // no animation for motion reduced on
    } else {
      Promise.race([
        document.fonts.ready,
        new Promise((resolve) => setTimeout(resolve, 1200)),
      ]).then(play);
    }
  }
</script> 
