<div class="content__wrapper">
  <nav class="content__navigation" aria-label="Project sections">
    <button
      class="content__navigation--button is-active area"
      data-section="briefing"
      type="button"
    >
      <span class="navigation__label--short">Briefing</span>
      <span class="navigation__label--long">The briefing</span>
    </button>

    <button
      class="content__navigation--button area"
      data-section="process"
      type="button"
    >
      <span class="navigation__label--short">Process</span>
      <span class="navigation__label--long">The process</span>
    </button>

    <button
      class="content__navigation--button area"
      data-section="result"
      type="button"
    >
      <span class="navigation__label--short">Result</span>
      <span class="navigation__label--long">The Result</span>
    </button>
  </nav>

  <div class="content__sections">
    <div class="content__markdown">
      <slot />
    </div>
  </div>
</div>

<script>
  import { initProjectProcess } from "../scripts/projectProcess";

  const wrapper = document.querySelector(".content__wrapper");

  if (wrapper) {
    const markdown = wrapper.querySelector(".content__markdown");
    const navigation = wrapper.querySelector(".content__navigation");

    if (markdown && navigation) {
      const children = Array.from(markdown.children);
      const sections: HTMLDivElement[] = [];
      let currentSection: HTMLDivElement | null = null;

      children.forEach((element) => {
        if (element.tagName === "H1") {
          const title = element.textContent?.trim().toLowerCase();

          if (
            title === "the briefing" ||
            title === "the process" ||
            title === "the result"
          ) {
            currentSection = document.createElement("div");

            currentSection.classList.add(
              "content__section",
              `content__section--${title.replace("the ", "")}`,
            );

            markdown.removeChild(element);

            sections.push(currentSection);
            return;
          }
        }

        if (currentSection) {
          currentSection.appendChild(element);
        }
      });

      sections.forEach((section) => {
        markdown.appendChild(section);
      });

      const buttons = navigation.querySelectorAll<HTMLButtonElement>(
        ".content__navigation--button",
      );

      const showSection = (sectionName: string) => {
        sections.forEach((section) => {
          section.classList.toggle(
            "is-active",
            section.classList.contains(`content__section--${sectionName}`),
          );
        });

        buttons.forEach((button) => {
          button.classList.toggle(
            "is-active",
            button.dataset.section === sectionName,
          );
        });
      };

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const sectionName = button.dataset.section;

          if (sectionName) {
            showSection(sectionName);
          }
        });
      });

      showSection("briefing");

      initProjectProcess();
    }
  }
</script>
