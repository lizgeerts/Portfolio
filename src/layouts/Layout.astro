---
import "../styles/reset.css";
import "../styles/global.css";
interface Props {
  title?: string;
}

const { title = "Liz Geerts — Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Liz Geerts — Digital Designer & Developer"
    />
    <link rel="stylesheet" href="https://use.typekit.net/yir6cpr.css" />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>
