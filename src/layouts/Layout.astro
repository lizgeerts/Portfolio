---
import "../styles/reset.css";
import "../styles/global.css";
interface Props {
  title?: string;
}

const { title = "Liz Geerts — Portfolio" } = Astro.props;
const faviconUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/flower.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Liz Geerts — Digital Designer & Developer"
    />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />

    <!-- Fallback for Safari, Chrome Cache & Mobile -->
    <link rel="shortcut icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" href={faviconUrl} />
    <!-- <link rel="icon" type="image/x-icon" href="/flower.ico" /> -->
    <link rel="stylesheet" href="https://use.typekit.net/yir6cpr.css" />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>
